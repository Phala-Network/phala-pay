{
  "name": "@phala/pay",
  "version": "0.8.3",
  "description": "Phala Pay framework-free browser client",
  "keywords": [
    "crypto",
    "checkout",
    "payments",
    "erc20",
    "eip-681",
    "eip-6963",
    "viem"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/Phala-Network/phala-pay/tree/main/sdk/js#readme",
  "bugs": {
    "url": "https://github.com/Phala-Network/phala-pay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phala-Network/phala-pay.git",
    "directory": "sdk/js"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "icons:generate": "node scripts/generate-icons.mjs",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:docker": "e2e/docker.sh",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run check-generated",
    "generate:types": "openapi-typescript ../../crates/topup/openapi.json -o src/generated/openapi.d.ts --immutable",
    "check-generated": "bash ../scripts/check-generated-js.sh",
    "test:fixtures": "pnpm --filter @phala/pay-server run test -- --run test/shared-fixtures.test.ts test/merchant-pins-ledger.test.ts test/merchant-transport.test.ts"
  },
  "dependencies": {
    "mipd": "^0.0.7"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "jsqr": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "viem": "^2.56.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "openapi-typescript": "7.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
