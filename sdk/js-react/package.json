{
  "name": "@phala/pay-react",
  "version": "0.10.0-rc.5",
  "description": "Phala Pay React checkout components",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Phala-Network/phala-pay/tree/main/sdk/js-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phala-Network/phala-pay.git",
    "directory": "sdk/js-react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "THIRD_PARTY_NOTICES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@phala/pay": "0.10.0-rc.5",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.3",
    "viem": "^2.57.2",
    "axe-core": "^4.13.0"
  }
}
