#!/bin/sh
set -eu

# PostgreSQL restore_command. PostgreSQL treats any exit status up to 125 as "segment not found"
# and ends recovery (promoting) there, so only WAL-G's 74, a segment that is not archived, may
# return 1; any other failure (storage, decryption with the wrong key) returns 126, which aborts
# recovery instead of promoting on a partial archive.
if [ "$#" -ne 2 ]; then
    echo "usage: walg-restore-command WAL_NAME DESTINATION" >&2
    exit 126
fi

set +e
"$(dirname "$0")/walg-cron" run restore wal-fetch "$1" "$2"
status=$?
set -e
case "$status" in
    0) exit 0 ;;
    74) exit 1 ;;
    *) exit 126 ;;
esac
