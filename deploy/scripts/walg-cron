#!/bin/sh
set -eu

# Shared bounded WAL-G runner, also used by bootstrap and restore_command. GNU timeout
# kills the entire process group, including a client stalled after connecting to S3.
if [ "${1:-}" = run ] && [ "$#" -ge 3 ]; then
    operation=$2
    shift 2
    case "$operation" in
        wal) deadline=${WALG_WAL_TIMEOUT_SECONDS:-10}; attempts=${WALG_WAL_ATTEMPTS:-1} ;;
        base) deadline=${WALG_BASE_TIMEOUT_SECONDS:-1800}; attempts=${WALG_BASE_ATTEMPTS:-2} ;;
        restore) deadline=${WALG_RESTORE_TIMEOUT_SECONDS:-120}; attempts=${WALG_RESTORE_ATTEMPTS:-3} ;;
        *) exit 64 ;;
    esac
    for value in "$deadline" "$attempts"; do
        case "$value" in ''|*[!0-9]*|0*) echo "WAL-G deadline and attempts must be positive integers" >&2; exit 64 ;; esac
    done
    if ! [ "$deadline" -le 86400 ] 2>/dev/null || ! [ "$attempts" -le 10 ] 2>/dev/null; then
        echo "WAL-G deadline must be at most 86400 seconds and attempts at most 10" >&2
        exit 64
    fi
    while :; do
        status=0
        timeout --kill-after=5 "$deadline" "${WALG_BIN:-wal-g}" "$@" || status=$?
        [ "$status" -ne 0 ] || exit 0
        # A genuinely absent WAL is the sole non-retryable restore result.
        [ "$operation" != restore ] || [ "$status" -ne 74 ] || exit 74
        attempts=$((attempts - 1))
        [ "$attempts" -gt 0 ] || exit "$status"
        sleep 1
    done
fi

write_marker() {
    marker="${WALG_OBSERVABILITY_DIR:-/run/topup-observability}/$1"
    mkdir -p "$(dirname "$marker")"
    (umask 022; printf '%s\n' "$2" > "$marker.tmp.$$"; chmod 0644 "$marker.tmp.$$")
    mv "$marker.tmp.$$" "$marker"
}

# Preserve the segment's data age: uploading an old backlog must never refresh recovery to now.
if [ "${1:-}" = "wal-push" ] && [ "$#" -eq 2 ]; then
    # The entrypoint already sets archive_mode=off for a restore; refuse a stray call as well.
    if [ "${TOPUP_RESTORE_FROM_BACKUP:-off}" = on ]; then
        echo "WAL archiving is disabled while TOPUP_RESTORE_FROM_BACKUP=on" >&2
        exit 1
    fi
    # Until the owner seals the S3 keys (deploy/README.md), fail at once: each WAL-G attempt
    # without credentials takes seconds, and PostgreSQL's shutdown after initdb waits for the
    # archiver, which would outlast pg_ctl's timeout and fail the first boot.
    if [ -z "${AWS_ACCESS_KEY_ID:-}" ]; then
        echo "WAL archiving waits for sealed object-storage credentials" >&2
        exit 1
    fi
    segment_time=$(stat -c %Y "$2")
    "$0" run wal wal-push "$2"
    write_marker last-backup-unix-seconds "$segment_time"
    exit 0
fi

if [ "${1:-}" != "backup-push" ] || [ "$#" -ne 2 ]; then
    echo 'usage: walg-cron backup-push "MINUTE HOUR * * *"' >&2
    exit 64
fi

schedule=$2
set -f
# shellcheck disable=SC2086  # one argument per cron field
set -- $schedule
set +f
if [ "$#" -ne 5 ] || [ "$3" != "*" ] || [ "$4" != "*" ] || [ "$5" != "*" ]; then
    echo "walg-cron supports one daily schedule: MINUTE HOUR * * *" >&2
    exit 64
fi

minute=$1
hour=$2
case "$minute:$hour" in
    *[!0-9:]*|:*|*:) echo "minute and hour must be decimal integers" >&2; exit 64 ;;
esac
if [ "$minute" -gt 59 ] || [ "$hour" -gt 23 ]; then
    echo "invalid daily schedule: $schedule" >&2
    exit 64
fi

retention=${WALG_RETENTION_FULL:-7}
case "$retention" in
    ''|*[!0-9]*) echo "WALG_RETENTION_FULL must be a positive integer" >&2; exit 64 ;;
esac
if [ "$retention" -eq 0 ]; then
    echo "WALG_RETENTION_FULL must be greater than zero" >&2
    exit 64
fi

echo "parsed schedule: minute=$minute hour=$hour day-of-month=$3 month=$4 day-of-week=$5"

# A restored instance (deploy/RESTORE.md) must not push base backups or delete retained ones in
# the prefix it restores from. It idles so the container stays up and healthy.
if [ "${TOPUP_RESTORE_FROM_BACKUP:-off}" = on ]; then
    echo "base backups are disabled while TOPUP_RESTORE_FROM_BACKUP=on"
    if [ "${WALG_CRON_DRY_RUN:-0}" = "1" ]; then
        exit 0
    fi
    exec sleep infinity
fi

if [ "${WALG_CRON_DRY_RUN:-0}" = "1" ]; then
    now=$(date -u +%s)
    run_at=$(date -u -d "$(date -u +%F) $hour:$minute:00" +%s)
    if [ "$run_at" -le "$now" ]; then
        run_at=$(date -u -d "tomorrow $hour:$minute:00" +%s)
    fi
    echo "next WAL-G base backup at $(date -u -d "@$run_at" +%FT%TZ)"
    echo "dry-run: wal-g backup-push ${PGDATA:-/var/lib/postgresql/data}"
    echo "dry-run: wal-g delete retain FULL $retention --use-sentinel-time --confirm"
    exit 0
fi

# archive_timeout only switches a segment that contains new WAL; the heartbeat service commits a
# row every minute, which keeps a segment switch, wal-push, and marker refresh every minute on an
# otherwise idle database. PostgreSQL 15+ (still true on 18) ignores archive_timeout after startup until the
# checkpointer first wakes (up to checkpoint_timeout later), so a CHECKPOINT is requested once per
# postmaster start.
checkpoint_on_start() {
    woken_postmaster=
    while :; do
        postmaster=$(psql -XAtq -c 'SELECT pg_catalog.pg_postmaster_start_time()') ||
            postmaster=
        if [ -n "$postmaster" ] && [ "$postmaster" != "$woken_postmaster" ]; then
            if psql -XAtq -c 'CHECKPOINT'; then
                woken_postmaster=$postmaster
            else
                echo "startup CHECKPOINT failed" >&2
            fi
        fi
        now=$(date -u +%s)
        gap=$(psql -XAtq -c "SELECT GREATEST(pg_wal_lsn_diff(pg_current_wal_insert_lsn(),
            (substr(last_archived_wal, 9, 8) || '/0')::pg_lsn)
            - (('x' || substr(last_archived_wal, 17, 8))::bit(32)::bigint + 1)
              * pg_size_bytes(current_setting('wal_segment_size')), 0)::bigint
            FROM pg_stat_archiver WHERE last_archived_wal ~ '^[0-9A-F]{24}$'") || gap=
        oldest=$(find "${PGDATA:-/var/lib/postgresql/data}/pg_wal/archive_status" -name '*.ready' \
            -printf '%T@\n' 2>/dev/null | sort -n | head -1) || oldest=
        backlog=0
        if [ -n "$oldest" ]; then backlog=$((now - ${oldest%%.*})); fi
        if [ -n "$gap" ]; then
            write_marker wal-progress "$now $backlog $gap"
        fi
        sleep 30
    done
}
checkpoint_on_start &
monitor_pid=$!
trap 'kill "$monitor_pid" 2>/dev/null || true; wait "$monitor_pid" 2>/dev/null || true' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# A base backup is due now, not at the schedule, when none covers the cluster's current timeline:
# a new cluster, or one promoted after a restore (deploy/RESTORE.md, "Resume"). A failed check or
# backup (PostgreSQL still starting, storage unreachable) keeps retrying with capped backoff.
# Markers from a previous cluster/timeline are not evidence that this timeline is covered.
rm -f "${WALG_OBSERVABILITY_DIR:-/run/topup-observability}/last-base-backup-unix-seconds"
backoff=5
while :; do
    status=0
    walg-timeline-backup "${PGDATA:-/var/lib/postgresql/data}" || status=$?
    case "$status" in
        0|3) break ;;
    esac
    echo "base backup check failed; retrying in ${backoff}s" >&2
    sleep "$backoff"
    backoff=$((backoff * 2))
    if [ "$backoff" -gt 300 ]; then backoff=300; fi
done

while :; do
    now=$(date -u +%s)
    run_at=$(date -u -d "$(date -u +%F) $hour:$minute:00" +%s)
    if [ "$run_at" -le "$now" ]; then
        run_at=$(date -u -d "tomorrow $hour:$minute:00" +%s)
    fi
    delay=$((run_at - now))
    echo "next WAL-G base backup at $(date -u -d "@$run_at" +%FT%TZ)"
    # Revalidate base existence on this timeline every five minutes, including after retention
    # or an external deletion. Failure clears evidence instead of trusting an old local marker.
    if [ "$delay" -gt 300 ]; then sleep 300; else sleep "$delay"; fi
    status=0
    walg-timeline-backup "${PGDATA:-/var/lib/postgresql/data}" || status=$?
    case "$status" in
        0|3) ;;
        *) rm -f "${WALG_OBSERVABILITY_DIR:-/run/topup-observability}/last-base-backup-unix-seconds"; continue ;;
    esac
    if [ "$delay" -gt 300 ]; then continue; fi
    if "$0" run base backup-push "${PGDATA:-/var/lib/postgresql/data}"; then
        write_marker last-base-backup-unix-seconds "$(date -u +%s)"
        "$0" run base delete retain FULL "$retention" --use-sentinel-time --confirm ||
            echo "backup retention failed; retained backups left intact" >&2
    else
        echo "scheduled base backup failed; existing backup age continues increasing" >&2
    fi
done
