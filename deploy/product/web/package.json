{
  "name": "reference-product-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "vite build && vite build --config vite.ssr.config.ts && node scripts/prerender.ts",
    "build:cloudflare": "(cd ../../../sdk/js && npx -y pnpm@12.6.0 install --frozen-lockfile --ignore-scripts && npx -y pnpm@12.6.0 -r --filter '@phala/pay-react...' --filter '@phala/pay-server' run build) && npx -y pnpm@12.6.0 install --frozen-lockfile && npx -y pnpm@12.6.0 run build",
    "build:cloudflare:preview": "CLOUDFLARE_PREVIEW_BUILD=true npm run build:cloudflare",
    "deploy": "cf deploy --prebuilt",
    "deploy:preview": "cf previews deploy --prebuilt",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:docker": "../../../sdk/js/e2e/docker.sh",
    "brand": "node brand/render.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "test": "node --test scripts/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phala/pay": "file:../../../sdk/js",
    "@phala/pay-react": "file:../../../sdk/js-react",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@eslint/js": "^10.0.1",
    "@phala/pay-server": "file:../../../sdk/js-server",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-beta.10",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hast-util-to-string": "^3.0.1",
    "parse5": "^8.0.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.1"
  }
}
