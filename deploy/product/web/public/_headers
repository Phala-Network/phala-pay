# Cloudflare's static-assets headers (developers.cloudflare.com/workers/static-assets/headers/).
# A request inherits the headers of every rule it matches, so each header is set by one rule only.
#
# The page reads the demo API (pay-demo-api.phala.com) and the service's public quote and deposit
# address views (pay-api-staging.phala.com), and sends the visitor's wallet requests through the
# wallet's provider (no network access). Its typeface is bundled with its assets; its web app
# manifest is its own. Radix ScrollArea injects a fixed scrollbar rule; the sole style hash
# permits that exact dependency stylesheet. SDK and application CSS are static assets.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'sha256-vGQdhYJbTuF+M8iCn1IZCHpdkiICocWHDq4qnQF4Rjw='; font-src 'self'; img-src 'self' data:; connect-src 'self' https://pay-demo-api.phala.com https://pay-api-staging.phala.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The page may change; its assets are named by content hash and never do.
/
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The icons, the manifest, the link preview image, and the crawlers' files keep fixed names that
# index.html, the manifest, and other sites link to: cached for a day.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400

# Branch Previews and production version URLs on workers.dev stay out of search results.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/compare
  Cache-Control: no-cache
/llms.txt
  Cache-Control: public, max-age=86400
/theme.js
  Cache-Control: public, max-age=86400
