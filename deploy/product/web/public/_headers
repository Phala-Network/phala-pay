# Cloudflare's static-assets headers (developers.cloudflare.com/workers/static-assets/headers/).
# A request inherits the headers of every rule it matches, so each header is set by one rule only.
#
# The page reads the demo API (pay-demo-api.phala.com) and the service's public quote and deposit
# address views (pay-api-staging.phala.com), and sends the visitor's wallet requests through the
# wallet's provider (no network access). Its typeface is bundled with its assets; its web app
# manifest is its own. Radix ScrollArea injects a fixed scrollbar rule; style-src's hash permits
# that exact dependency stylesheet. The prerendered demo carries the style attributes Radix renders
# (a tab list's and a tab panel's, a radio group's form input); style-src-attr permits those values
# by their exact hashes ('unsafe-hashes') and no others (scripts/prerender.ts checks every page's).
# The script hash permits only the theme bootstrap. SDK and application CSS are static assets.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-jL+r/wyn21X9/1x5JDr0VxnGQROJD5W7MmAaQIYsJRQ='; style-src 'self' 'sha256-vGQdhYJbTuF+M8iCn1IZCHpdkiICocWHDq4qnQF4Rjw='; style-src-attr 'unsafe-hashes' 'sha256-MtxTLcyxVEJFNLEIqbVTaqR4WWr0+lYSZ78AzGmNsuA=' 'sha256-PhrR5O1xWiklTp5YfH8xWeig83Y/rhbrdb5whLn1pSg=' 'sha256-2cnE1GtP/E924RqY1dke4GjgMTwo242VoJSnZn4Jdcw='; font-src 'self'; img-src 'self' data:; connect-src 'self' https://pay-demo-api.phala.com https://pay-api-staging.phala.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The page may change; its assets are named by content hash and never do.
/
  Cache-Control: no-cache

/compare
  Cache-Control: no-cache

/docs
  Cache-Control: no-cache

/docs/*
  Cache-Control: no-cache

/reference
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The icons, the manifest, the link preview image, and the crawlers' files keep fixed names that
# index.html, the manifest, and other sites link to: cached for a day.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400

# Branch Previews and production version URLs on workers.dev stay out of search results.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/llms.txt
  Cache-Control: public, max-age=86400
